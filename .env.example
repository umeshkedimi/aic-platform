# Copy to .env and fill in. Never commit the real file — .gitignore already
# excludes it.
#
# Two consumers read this file:
#   1. `docker compose` interpolates the POSTGRES_*/MINIO_ROOT_*/JWT_SECRET_KEY
#      vars into the container definitions in docker/docker-compose.yml.
#   2. `app.core.config.Settings` reads it directly (via pydantic-settings)
#      when you run the API on the host against dockerized infra — e.g.
#      `uv run uvicorn app.main:app --reload` while `make up` runs everything
#      else. That is why the *_URL vars below point at `localhost`: from the
#      host, the compose ports are published there; from inside the `api`
#      container they would instead be the service names (`postgres`,
#      `redis`, ...) — docker-compose.yml sets that itself and does not read
#      these URL vars from here.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# --- Postgres ------------------------------------------------------------
# POSTGRES_* are used by docker compose to initialise the container.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_platform
DATABASE_URL=postgresql://rag:change-me@localhost:5432/rag_platform

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- Object storage (MinIO) -------------------------------------------------
MINIO_ROOT_USER=rag-admin
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rag-admin
S3_SECRET_KEY=change-me-too
S3_BUCKET_DOCUMENTS=documents

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
